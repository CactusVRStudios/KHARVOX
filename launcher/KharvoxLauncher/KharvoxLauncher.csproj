<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <AssemblyName>KharvoxLauncher</AssemblyName>
    <RootNamespace>KharvoxLauncher</RootNamespace>
    <Product>KHARVOX</Product>
    <Title>KHARVOX Launcher</Title>
    <AssemblyTitle>KHARVOX Launcher</AssemblyTitle>
    <AssemblyProduct>KHARVOX</AssemblyProduct>
    <AssemblyDescription>An independent VR compatibility framework</AssemblyDescription>
    <Description>An independent VR compatibility framework</Description>
    <Version>0.9.6</Version>
    <FileVersion>0.9.6.417</FileVersion>
    <InformationalVersion>0.9.6-test.17</InformationalVersion>
    <ApplicationIcon>..\..\assets\branding\kharvox.ico</ApplicationIcon>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\branding\kharvox-logo-dark.png">
      <LogicalName>Kharvox.Branding.Logo</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\assets\branding\kharvox-blood-splatter-round.png">
      <LogicalName>Kharvox.Branding.BloodSplatter</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\assets\branding\kharvox-manual-book.png">
      <LogicalName>Kharvox.Branding.ManualBook</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\assets\branding\kharvox-mark-transparent.png">
      <LogicalName>Kharvox.Branding.ManualMark</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\assets\branding\bhaptics-logo-transparent.png">
      <LogicalName>Kharvox.Branding.BhapticsLogo</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\assets\branding\psvr2-toolkit-logo.png">
      <LogicalName>Kharvox.Branding.Psvr2ToolkitLogo</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\assets\branding\quest-controller-mapping.png">
      <LogicalName>Kharvox.Branding.ControllerMapping</LogicalName>
    </EmbeddedResource>
    <Compile Include="..\..\third-party\oldschoolengine2\*.cs" Link="SidEmulation\%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\assets\cracktro\*.gif;..\..\assets\cracktro\*.sid;..\..\assets\cracktro\cactus-vr-mask.png"
                      Exclude="..\..\assets\cracktro\papillon_inside.gif;..\..\assets\cracktro\papillon_outside.gif">
      <LogicalName>Kharvox.Cracktro.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\assets\cracktro\amiga\kharvox-amiga.png;..\..\assets\cracktro\amiga\font32.png;..\..\assets\cracktro\amiga\cop.png;..\..\assets\cracktro\amiga\eq.png;..\..\assets\cracktro\amiga\possessed.paula.gz">
      <LogicalName>Kharvox.Cracktro.Amiga.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Management" />
    <Reference Include="System.Security" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\third-party\pocketmod\LICENSE.txt"><LogicalName>Kharvox.Licenses.Pocketmod</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="..\..\LICENSE.txt"><LogicalName>Kharvox.Licenses.KHARVOX</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="..\..\Docs\THIRD_PARTY_NOTICES.txt"><LogicalName>Kharvox.Licenses.Notices</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="..\..\third-party\openxr-sdk\LICENSE"><LogicalName>Kharvox.Licenses.OpenXR</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="..\..\third-party\vulkan-headers\LICENSE.txt"><LogicalName>Kharvox.Licenses.Vulkan</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="..\..\third-party\fsr1\LICENSE"><LogicalName>Kharvox.Licenses.FSR1</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="..\..\third-party\cgltf\LICENSE"><LogicalName>Kharvox.Licenses.cgltf</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="..\..\third-party\psvr2-toolkit\LICENSE"><LogicalName>Kharvox.Licenses.PSVR2Toolkit</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="..\..\third-party\minhook\LICENSE.txt"><LogicalName>Kharvox.Licenses.MinHook</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="..\..\src\native\upstream\LICENSE"><LogicalName>Kharvox.Licenses.NativeStereo</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="..\..\src\native\upstream\RENDERDOC-LICENSE.txt"><LogicalName>Kharvox.Licenses.RenderDoc</LogicalName></EmbeddedResource>
  </ItemGroup>
</Project>
