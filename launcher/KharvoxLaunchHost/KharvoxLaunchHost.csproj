<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>KharvoxLaunchHost</AssemblyName>
    <Version>1.4.2</Version>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs;SettingsLaunchOptions.cs" />
    <Compile Include="../KharvoxLauncher/KharvoxRunner.cs" />
    <Compile Include="../KharvoxLauncher/LauncherSettings.cs" />
    <Compile Include="../KharvoxLauncher/LauncherPresetPolicy.cs" />
    <Compile Include="../KharvoxLauncher/RendererSelection.cs" />
    <Compile Include="../KharvoxLauncher/VulkanSfs.cs" />
    <Compile Include="../KharvoxLauncher/DoomBuildProfile.cs" />
    <Compile Include="../KharvoxLauncher/HeadsetUnavailableException.cs" />
    <Compile Include="../KharvoxLauncher/RenderMemoryCapacityException.cs" />
    <Compile Include="../KharvoxLauncher/LaunchPreflight.cs" />
    <Compile Include="../KharvoxLauncher/ModConflictPreflight.cs" />
    <Compile Include="../KharvoxLauncher/NativeLaunchRecovery.cs" />
    <Compile Include="../KharvoxLauncher/NativeValidation.cs" />
    <Compile Include="../KharvoxLauncher/SteamVrSettings.cs" />
    <Compile Include="../KharvoxLauncher/BhapticsBridgeSession.cs" />
    <Compile Include="../KharvoxLauncher/Psvr2BridgeSession.cs" />
    <Compile Include="../KharvoxLauncher/VrGameIntroSession.cs" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Management" />
    <Reference Include="System.Security" />
  </ItemGroup>
</Project>
